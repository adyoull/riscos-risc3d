#!/bin/sh
# RISC3D test kit 34: after installing riscos-risc3d 0.19-1 and upgrading
# Mesa from trixie-backports, check what's installed and draw lit, litx2
# and the TORCS recording with it. Writes Check-*.png and CheckLog into
# this folder. Run as root:
#   sh /riscos/HardDisc4/RISC3DTest/check /riscos/3d/recorded/ctx-477.r3d
d=$(dirname "$0")
log="$d/CheckLog"
g=$(ls "$d"/gl1test-linux* 2>/dev/null | head -1)
chmod 755 "$g"
rm -f "$d"/Check-*
{
  echo "== Mesa packages"
  apt-cache policy libgl1-mesa-dri mesa-libgallium 2>&1
  echo "== lit, litx2 (Linux directly)"
  "$g" lit "$d/Check-lit.png"
  "$g" litx2 "$d/Check-litx2.png"
  if [ -f "$1" ]; then
    echo "== TORCS recording through rol-3d"
    /opt/riscos/rol-3d --replay "$1" "$d/Check-replay" 240
  fi
} > "$log" 2>&1
chown 1000:1000 "$d"/Check* 2>/dev/null
sync
cat "$log"
