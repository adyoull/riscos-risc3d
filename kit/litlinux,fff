#!/bin/sh
# RISC3D test kit 29: TORCS's lighting drawn by Linux's Mesa directly,
# to compare with the Lit obey file (through RISC3D). Run as root:
#   sh /riscos/HardDisc4/RISC3DTest/litlinux
d=$(dirname "$0")
g=$(ls "$d"/gl1test-linux* 2>/dev/null | head -1)
[ -n "$g" ] || { echo "gl1test-linux is missing"; exit 1; }
chmod 755 "$g"
"$g" lit "$d/LitLinuxPicture.png" >"$d/LitLinuxResults" 2>&1
chown 1000:1000 "$d"/LitLinux* 2>/dev/null
cat "$d/LitLinuxResults"
