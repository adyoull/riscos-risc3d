#!/bin/sh
# RISC3D test kit 30: twelve variations of TORCS's lighting drawn by
# Linux's Mesa directly (no RISC OS, no RISC3D), to find what avoids the
# Pi's V3D bug (texture coordinates lost when GL_LIGHTING is on).
# Writes LitX-*.png and LitXResults into this folder. Run as root:
#   sh /riscos/HardDisc4/RISC3DTest/litx
d=$(dirname "$0")
g=$(ls "$d"/gl1test-linux* 2>/dev/null | head -1)
[ -n "$g" ] || { echo "gl1test-linux is missing"; exit 1; }
chmod 755 "$g"
rm -f "$d"/LitX*
{
  echo "== GPU, as normal"
  "$g" litx "$d/LitX-GPU.png"
  echo "== GPU, MESA_GL_VERSION_OVERRIDE=2.1"
  MESA_GL_VERSION_OVERRIDE=2.1 "$g" litx "$d/LitX-GPU21.png"
  echo "== software"
  LIBGL_ALWAYS_SOFTWARE=1 "$g" litx "$d/LitX-Soft.png"
} >"$d/LitXResults" 2>&1
chown 1000:1000 "$d"/LitX* 2>/dev/null
cat "$d/LitXResults"
