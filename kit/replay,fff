#!/bin/sh
# RISC3D test kit 27: draw a recording again and check its textures on
# the GPU. Writes into this folder:
#   ReplayGPU-<frame>.png, ReplayGPU-cardmip-<frame>.png and
#   ReplayGPU-cardbase-<frame>.png   on the GPU
#   ReplaySoft-...                    the same in software
#   ReplayLog                         what rol-3d said
# Run as root:
#   sh /riscos/HardDisc4/RISC3DTest/replay /riscos/3d/recorded/ctx-477.r3d 240
d=$(dirname "$0")
[ -f "$1" ] || { echo "Give a recording (sh record list shows them)."; exit 1; }
w=${2:-240}
r=/opt/riscos/rol-3d
rm -f "$d"/Replay*
sync
ROL3D_REPLAY=texcheck $r --replay "$1" "$d/ReplayGPU" "$w" 2>&1 | tee "$d/ReplayLog"
sync
ROL3D_REPLAY=texcheck ROL3D_SOFTWARE=1 LIBGL_ALWAYS_SOFTWARE=1 $r --replay "$1" "$d/ReplaySoft" "$w" 2>&1 | tee -a "$d/ReplayLog"
chown 1000:1000 "$d"/Replay* 2>/dev/null
sync
ls "$d" | grep Replay
