#!/bin/sh
# RISC3D test kit 25: draw a recording again here, writing the frames
# asked for as PPM pictures into this folder:
#   ReplayGPU-<frame>      on the GPU, as the program had it
#   ReplayBuffers-<frame>  on the GPU, arrays and indices put into buffers
#                          by rol-3d (as 0.8 did) instead of given to Mesa
#                          as memory
#   ReplayBufNoMip-<frame> the same, and without mipmaps
#   ReplaySoft-<frame>     in Linux's software renderer
# Run as root:
#   sh /riscos/HardDisc4/RISC3DTest/replay /riscos/3d/recorded/ctx-477.r3d 240
d=$(dirname "$0")
[ -f "$1" ] || { echo "Give a recording (sh record list shows them)."; exit 1; }
w=${2:-/50}
u=/riscos/3d/uploads
had=; [ -f $u ] && had=$(cat $u)
/opt/riscos/rol-3d --replay "$1" "$d/ReplayGPU" "$w"
echo buffers > $u
/opt/riscos/rol-3d --replay "$1" "$d/ReplayBuffers" "$w"
ROL3D_REPLAY_NOMIP=1 /opt/riscos/rol-3d --replay "$1" "$d/ReplayBufNoMip" "$w"
if [ -n "$had" ]; then echo "$had" > $u; else rm -f $u; fi
ROL3D_SOFTWARE=1 LIBGL_ALWAYS_SOFTWARE=1 /opt/riscos/rol-3d --replay "$1" "$d/ReplaySoft" "$w"
chown 1000:1000 "$d"/Replay*.ppm 2>/dev/null
for f in "$d"/Replay*.ppm; do [ -e "$f" ] && mv "$f" "${f%.ppm}"; done
ls "$d" | grep Replay
