#!/bin/sh
# RISC3D test kit 19: what Linux is doing while a program runs, every 5
# seconds, into WatchResults (memory, swap, and the busiest processes).
# From RiSH's root shell, then start TORCS straight away:
#   sh /riscos/HardDisc4/RISC3DTest/watch 900 &
# (900: how many seconds to watch; it stops by itself.)
d=$(dirname "$0")
o="$d/WatchResults"
n=${1:-600}
: >"$o"
chown 1000:1000 "$o" 2>/dev/null
end=$(( $(date +%s) + n ))
while [ "$(date +%s)" -lt "$end" ]; do
  {
    echo "=== $(date +%T)"
    free -m
    grep -E '^(pswpin|pswpout|pgmajfault) ' /proc/vmstat | tr '\n' ' '; echo
    top -b -n 1 -w 160 | sed -n '1,5p;7,16p'
    for p in $(pgrep -x rol-3d); do
      printf 'rol-3d %s: ' "$p"; grep -E '^(VmRSS|VmSwap)' /proc/$p/status 2>/dev/null | tr -s ' \n' ' '; echo
    done
  } >>"$o" 2>&1
  sleep 5
done
echo "watch: done" >>"$o"
