#!/bin/sh
# RISC3D (Linux's side): rol-3d runs now; RISC OS's side is the PackMan
# package RISC3D, which riscos-harddisc installs.
# Copyright (c) 2026 Andrew Youll. MIT licence.
set -e
ro () { if [ -e "$1" ]; then echo "$1"; else echo "$1,$2"; fi; }
if [ "$1" = configure ]; then
  hd=/riscos/HardDisc4
  pk="$hd/!Boot/Resources/!Packages"
  stg=/usr/share/riscos/packman/RISC3D
  # RISC OS's side is PackMan's (riscos-harddisc stages and installs it).
  # dpkg removes 0.21-1's files in !RISC3D on this upgrade, at the same
  # paths as PackMan's copy: put back what is missing when Status has it.
  stf=$(ro "$pk/Status" fff)
  if [ -d "$stg/!Boot" ] && [ -f "$stf" ] && awk -F'\t' '$1 == "RISC3D" && $3 == "installed" { f = 1 } END { exit !f }' "$stf"; then
    (cd "$stg" && find '!Boot' -type f) | while read -r f; do
      b=${f%,[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]}
      if [ ! -e "$hd/$b" ] && [ ! -e "$hd/$f" ]; then
        mkdir -p "$hd/$(dirname "$f")"
        cp -a "$stg/$f" "$hd/$f"
        chown 1000:1000 "$hd/$f" "$hd/$(dirname "$f")"
      fi
    done
  elif [ -x /usr/lib/riscos/install-packman-packages ]; then
    /usr/lib/riscos/install-packman-packages
  fi
  # 0.19-1 to 0.21-1's start-up file: !Boot.Resources loads !RISC3D now
  pd="$hd/!Boot/Choices/Boot/PreDesk"
  for f in "$pd/RISC3D" "$pd/RISC3D,feb"; do
    if [ -f "$f" ] && grep -q '(riscos-risc3d)' "$f"; then rm -f "$f"; fi
  done
  rm -f /var/lib/riscos/risc3d-predesk
  # the new rol-3d now (init starts it at each start-up from riscos-support
  # 1.0.0049-1)
  for p in $(pidof rol-3d 2>/dev/null); do kill "$p" 2>/dev/null || true; done
  setsid /opt/riscos/rol-3d </dev/null >/dev/null 2>&1 &
  if [ -z "$2" ]; then
    echo "RISC3D's Linux side is installed. Restart (shut down and switch on) so that"
    echo "RISC OS loads RISC3D and its Linux3D driver."
  else
    echo "RISC3D's Linux side is updated and its helper restarted. RISC OS's side is"
    echo "the PackMan package RISC3D from now on."
  fi
  # Mesa 25.2 or later, from trixie-backports (pinned by this package's
  # apt files): once, when those files first arrive, ask Updates to run
  # apt again (riscos-support 1.0.0055-1's hook)
  ag=/var/lib/riscos/risc3d-backports
  if [ ! -e "$ag" ]; then
    mkdir -p /var/lib/riscos
    : > /var/lib/riscos/apt-again
    : > "$ag"
    echo "RISC3D needs Mesa 25.2 or later, which comes from Debian's trixie-backports"
    echo "(now set up and pinned for Mesa only). Configure > Updates fetches it; by"
    echo "hand: apt update, then apt full-upgrade."
  fi
  if ! grep -qa /opt/riscos/rol-3d /usr/sbin/init 2>/dev/null; then
    echo "This riscos-support's init doesn't start rol-3d: after each restart, until"
    echo "you have riscos-support 1.0.0049-1, start it as root: setsid /opt/riscos/rol-3d &"
  fi
fi
exit 0
