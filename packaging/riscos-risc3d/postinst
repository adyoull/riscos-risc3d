#!/bin/sh
# RISC3D: the modules belong to RISC OS (uid 1000), load at start-up, and
# rol-3d runs now.
# Copyright (c) 2026 Andrew Youll. MIT licence.
set -e
ro () { if [ -e "$1" ]; then echo "$1"; else echo "$1,$2"; fi; }
if [ "$1" = configure ]; then
  chown -R 1000:1000 "/riscos/HardDisc4/!Boot/Resources/!RISC3D"
  pd=/riscos/HardDisc4/!Boot/Choices/Boot/PreDesk
  st=/var/lib/riscos/risc3d-predesk
  f=$(ro "$pd/RISC3D" feb)
  # the start-up file: made once (deleting it to stop RISC3D loading is
  # kept); 0.19-1's and earlier (TestBed paths) is replaced
  if [ -d "$pd" ] && { [ ! -e "$st" ] || grep -q 'TestBed.RISC3D' "$f" 2>/dev/null; }; then
    printf '%s\n' \
      "| RISC3D: GPU drawing for RISC OS programs (riscos-risc3d). Delete this" \
      "| file to stop it loading at start-up; it's put here once." \
      "IfThere <IXFS\$HardDisc4>.!Boot.Resources.!RISC3D.!Boot Then /<IXFS\$HardDisc4>.!Boot.Resources.!RISC3D.!Boot" \
      "If \"<RISC3D\$Dir>\"<>\"\" Then RMEnsure RISC3D 0.04 RMLoad RISC3D:RISC3D" > "$f"
    chown 1000:1000 "$f"
    mkdir -p /var/lib/riscos
    : > "$st"
  fi
  # the new rol-3d now (init starts it at each start-up from riscos-support
  # 1.0.0049-1)
  for p in $(pidof rol-3d 2>/dev/null); do kill "$p" 2>/dev/null || true; done
  setsid /opt/riscos/rol-3d </dev/null >/dev/null 2>&1 &
  if [ -z "$2" ]; then
    echo "RISC3D is installed. Restart (shut down and switch on) to load it, or in"
    echo "RISC OS: *RMLoad <IXFS\$HardDisc4>.!Boot.Resources.!RISC3D.RISC3D"
    echo "(after double-clicking !RISC3D in !Boot.Resources)."
  else
    echo "RISC3D is updated and its helper restarted. RISC3D 0.04 now lives in"
    echo "!Boot.Resources.!RISC3D and loads Linux3D itself: restart to use it."
  fi
  # Mesa 25.2 or later, from trixie-backports (pinned by this package's
  # apt files): once, when those files first arrive, ask Updates to run
  # apt again (riscos-support 1.0.0055-1's hook)
  ag=/var/lib/riscos/risc3d-backports
  if [ ! -e "$ag" ]; then
    mkdir -p /var/lib/riscos
    : > /var/lib/riscos/apt-again
    : > "$ag"
    echo "RISC3D needs Mesa 25.2 or later, which comes from Debian's trixie-backports"
    echo "(now set up and pinned for Mesa only). Configure > Updates fetches it; by"
    echo "hand: apt update, then apt full-upgrade."
  fi
  if ! grep -qa /opt/riscos/rol-3d /usr/sbin/init 2>/dev/null; then
    echo "This riscos-support's init doesn't start rol-3d: after each restart, until"
    echo "you have riscos-support 1.0.0049-1, start it as root: setsid /opt/riscos/rol-3d &"
  fi
fi
exit 0
